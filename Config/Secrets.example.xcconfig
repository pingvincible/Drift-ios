// Copy this file to Config/Secrets.xcconfig and put your own key in it.
// Config/Secrets.xcconfig is git-ignored and never leaves your machine.
//
// A key is issued at https://unsplash.com/oauth/applications (Access Key).
// Without a key the app still runs: it plays whatever is already in the cache.

UNSPLASH_ACCESS_KEY = your_unsplash_access_key_here
